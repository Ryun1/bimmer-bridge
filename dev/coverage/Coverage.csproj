<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Mac side of the M1 coverage comparison, and the comparator. Runs upstream's
       coverage.bat job list (dev/coverage/jobs.json) on upstream's test SGBDs, in place from
       the submodule, through ediabasd's engine (EdiabasLib.Native). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>coverage</AssemblyName>
    <RootNamespace>Coverage</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../engine/EdiabasLib.Native/EdiabasLib.Native.csproj" />
  </ItemGroup>
</Project>
