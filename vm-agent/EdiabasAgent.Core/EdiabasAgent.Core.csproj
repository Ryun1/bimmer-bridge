<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral logic: no Windows APIs, no ASP.NET. Unit-tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EdiabasAgent.Core</RootNamespace>
    <AssemblyName>EdiabasAgent.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The job policy is linked, never copied: policy/policy.json is the single source for
         both the agent and the Mac server. -->
    <EmbeddedResource Include="..\..\policy\policy.json" Link="policy.json" LogicalName="EdiabasAgent.Core.policy.json" />
  </ItemGroup>

</Project>
