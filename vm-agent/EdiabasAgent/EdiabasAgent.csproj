<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <OutputType>WinExe</OutputType>
    <AssemblyName>EdiabasAgent</AssemblyName>
    <RootNamespace>EdiabasAgent</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>true</UseAppHost>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- No appsettings.json, no launchSettings: the agent reads only its own config.json. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No wwwroot / static web assets: the agent serves JSON only. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- Not hosted in IIS: do not generate web.config. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EdiabasAgent.Core\EdiabasAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GDI+ (Windows' own gdiplus.dll) for scaling and JPEG/PNG encoding of screenshots.
         First-party; the version matches the runtime the agent is built with. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.15" />
  </ItemGroup>

</Project>
